{
  "app": {
    "name": "pps-services-publisher-database",
    "version": "1.0.0"
  },
  "web": {
    "prefork": false,
    "port": 3000
  },
  "security": {
    "api_key": "pps-secret-api-key-change-me"
  },
  "log": {
    "level": 6,
    "output": "both",
    "file": {
      "path": "logs/app.log",
      "max_size": 100,
      "max_backups": 30,
      "max_age": 30,
      "compress": true
    },
    "telegram": {
      "enabled": false,
      "bot_token": "",
      "chat_id": ""
    }
  },
  "oracle": {
    "host": "192.168.3.163",
    "port": 2015,
    "service": "evshop",
    "username": "MSG",
    "password": "RESTORE",
    "pool": {
      "max_open": 25,
      "max_idle": 10,
      "max_lifetime": 300
    }
  },
  "rabbitmq": {
    "host": "localhost",
    "port": 5672,
    "username": "guest",
    "password": "guest",
    "vhost": "/",
    "channel_pool_size": 10,
    "exchange": {
      "name": "pps.transaction",
      "type": "direct",
      "durable": true
    },
    "dead_letter": {
      "enabled": true,
      "exchange": "pps.transaction.dlx",
      "suffix": ".dead",
      "delivery_limit": 3
    },
    "queue_declare_mode": "lazy",
    "startup_queues": [],
    "reconnect": {
      "initial_interval": 2,
      "max_interval": 60
    },
    "publish": {
      "backoff_initial_interval_ms": 500,
      "backoff_max_interval": 10,
      "backoff_max_elapsed_time": 60,
      "timeout": 10
    }
  },
  "circuit_breaker": {
    "max_requests": 5,
    "interval": 60,
    "timeout": 30,
    "failure_threshold": 3
  }
}
