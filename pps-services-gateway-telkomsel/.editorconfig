# EditorConfig — https://editorconfig.org
# Letakkan di root proyek. Otomatis dipakai oleh VS Code, GoLand, Vim, dll.

root = true

# === Default semua file ===
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = tab
indent_size = 4

# === Go files — tab (standard Go) ===
[*.go]
indent_style = tab
indent_size = 4

# === Makefile — harus tab ===
[Makefile]
indent_style = tab

# === YAML / JSON / Markdown ===
[*.{yml,yaml,json}]
indent_style = space
indent_size = 2

[*.md]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false

# === SQL migrations ===
[*.sql]
indent_style = space
indent_size = 4

# === Dockerfile ===
[Dockerfile]
indent_style = space
indent_size = 4

# === Shell scripts ===
[*.sh]
indent_style = space
indent_size = 2
end_of_line = lf
