# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
QUEUE_NAME_PROVIDER=queue_smb_pln_token
CONSUMER_TAG=pps-services-gateway-smb-consumer

# SMB / Loket Bayar API
SMB_BASE_URL=https://api.example.com
SMB_PARTNER_ID=your_partner_id
SMB_SECRET_KEY=your_secret_key
SMB_TIMEOUT_SEC=30

# Retry Config
RETRY_MAX_ATTEMPTS=4
RETRY_WAIT_SECONDS=10

# Postgres (optional — for transaction logging)
POSTGRES_DSN=postgres://user:pass@localhost:5432/pps_smb?sslmode=disable

# HTTP Server
HTTP_PORT=8080
READ_TIMEOUT_SEC=30
